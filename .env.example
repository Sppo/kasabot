# ============================================================================
# KasaBot — Операційна конфігурація сервера (.env.example)
# Скопіюйте цей файл у .env та заповніть секретні ключі перед запуском.
# Усі змінні зчитуються виключно в internal/core/config.go.
# ============================================================================

# Порт HTTP-сервера (ціле число, за замовчуванням: 8080)
PORT=8080

# Налаштування локального контейнера PostgreSQL (docker-compose.yml)
# Порт хоста для підключення до локального PostgreSQL (ціле число, за замовчуванням: 5432)
POSTGRES_PORT=5432
# Користувач PostgreSQL у контейнері (рядок, за замовчуванням: kasabot)
POSTGRES_USER=kasabot
# Пароль користувача PostgreSQL у контейнері (обов'язково змініть у продакшні)
POSTGRES_PASSWORD=kasabot
# Назва бази даних PostgreSQL у контейнері (рядок, за замовчуванням: kasabot)
POSTGRES_DB=kasabot

# Рядок підключення до PostgreSQL (обов'язковий параметр; узгоджується з POSTGRES_* вище)
DATABASE_URL=postgres://kasabot:kasabot@127.0.0.1:5432/kasabot?sslmode=disable

# Максимальна кількість з'єднань у пулі pgxpool (ціле число, за замовчуванням: 10)
DB_MAX_CONNS=10

# Таймаут підключення та перевірки Ping до PostgreSQL при старті (секунди, за замовчуванням: 5)
DB_CONNECT_TIMEOUT_SEC=5

# Таймаут обробки вхідних HTTP-запитів сервера (секунди, за замовчуванням: 30)
HTTP_TIMEOUT_SEC=30

# Максимальний дозволений розмір JSON-тіла HTTP-запиту (байти, за замовчуванням: 1048576 = 1 МБ)
MAX_JSON_BODY_BYTES=1048576

# Секретний ключ для підпису JWT-токенів (обов'язковий параметр, мінімум 16 символів; замініть плейсхолдер перед запуском)
JWT_SECRET=change-me-in-production-min-16-chars

# Час життя JWT-токена авторизації користувача (години, за замовчуванням: 168 = 7 діб)
JWT_TTL_HOURS=168

# Ключ API Google Gemini для розпізнавання голосу та тексту (обов'язковий для реального AI-парсингу)
GEMINI_API_KEY=

# Назва моделі Google Gemini (рядок, за замовчуванням: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Таймаут очікування відповіді від Gemini API (секунди, за замовчуванням: 25)
AI_REQUEST_TIMEOUT_SEC=25

# Максимальний дозволений розмір аудіофайлу для голосового вводу (байти, за замовчуванням: 3145728 = 3 МБ)
MAX_AUDIO_SIZE_BYTES=3145728

# Тривалість безкоштовного пробного періоду для нового воркспейсу (дні, за замовчуванням: 14)
TRIAL_DAYS=14

# Денний ліміт успішних AI-запитів на один воркспейс під час тріалу (кількість на добу, за замовчуванням: 15)
TRIAL_DAILY_AI_LIMIT=15

# Денний ліміт успішних AI-запитів на один воркспейс на активній підписці (кількість на добу, за замовчуванням: 60)
ACTIVE_DAILY_AI_LIMIT=60

# Час дії одноразового інвайт-коду для запрошення партнера у воркспейс (години, за замовчуванням: 48)
WORKSPACE_INVITE_TTL_HOURS=48

# Токен Telegram-бота (опціонально: якщо порожній — система працює тільки у Web/Mobile режимі)
TG_BOT_TOKEN=

# Час дії одноразового коду прив'язки Telegram-акаунту (хвилини, за замовчуванням: 10)
TG_LINK_TOKEN_TTL_MIN=10

# Часовий пояс за замовчуванням для розпізнавання відносних дат "вчора/сьогодні" (IANA таймзона, за замовчуванням: Europe/Kyiv)
DEFAULT_TIMEZONE=Europe/Kyiv

# Валюта нового воркспейсу за замовчуванням (ISO 4217 код з 3 літер, за замовчуванням: UAH)
DEFAULT_CURRENCY=UAH

# Каталог для збереження файлів логів по днях (рядок, за замовчуванням: logs)
LOG_DIR=logs

# Кількість днів зберігання файлів логів (ціле число >= 0; 0 = не видаляти старі логи, за замовчуванням: 0)
LOG_RETENTION_DAYS=0
